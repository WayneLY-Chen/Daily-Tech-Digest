GITHUB_TOKEN=
SUPABASE_URL=
# 後端要的是 service role 金鑰，不是 anon 金鑰：digest_posts / processed_urls
# 的 RLS 政策是「僅限服務金鑰寫入」，用 anon 金鑰每一筆 insert 都會被擋下。
# 這把金鑰會繞過 RLS，只能放伺服器端，絕不可進 frontend/.env 或被前端打包。
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
MAX_DAILY_ITEMS=10
# 觸發 POST /run 的共享密鑰。未設定時 /run 一律回 503（fail-closed）。
RUN_TOKEN=
